{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "framework": "create-react-app",
  "redirects": [
    {
      "source": "/ios/download",
      "destination": "https://apps.apple.com/ca/app/trackabite-meal-planner/id6759185932",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://apps.apple.com/ca/app/trackabite-meal-planner/id6759185932",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.trackabite.app/api/blog/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
